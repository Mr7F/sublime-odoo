%YAML 1.2
---
# Odoo OWL template with javascript as expression
name: XML - Odoo - OWL
scope: text.xml.owl
version: 2

extends: Packages/XML/XML.sublime-syntax

file_extensions:
  - xml

variables:
  owl_attribute_charset: '[A-Za-z0-9._-]'

contexts:
  tag:
    - meta_prepend: true
    - include: owl-component-tag
    - include: owl-attribute-tag

  tag-attribute:
    - meta_prepend: true
    - include: owl-directive

  owl-directive:
    - match: (?i:(t-name))
      scope: entity.other.attribute-name
      push: owl-symbols-assignment
    - match: (expr)
      scope: entity.other.attribute-name
      push: owl-xpath-assignment
    - match: (position)
      scope: entity.other.attribute-name
      push: owl-position-assignment
    - match: (?i:(t-call(-{{owl_attribute_charset}}+)?)|t-inherit(?!{{owl_attribute_charset}}))
      scope: entity.other.attribute-name
      push: owl-reference-assignment
    # `t-att` attribute
    - match: (?i:(t-name|t-set-slot|t-slot-scope|t-inherit({{owl_attribute_charset}}*))|t-ref)
      scope: entity.other.attribute-name
      push: tag-else-pop
    - match: (?i:(t-attf-{{owl_attribute_charset}}+)|(t-valuef))
      scope: entity.other.attribute-name
      push: owl-attf-assignment
    - match: (?i:t-{{owl_attribute_charset}}+)
      scope: entity.other.attribute-name
      push: owl-directive-assignment

  # -----------------------------------------------------------------------
  # `t-att-`
  # -----------------------------------------------------------------------

  owl-directive-assignment:
    - meta_content_scope: meta.directive.owl
    - match: =
      scope: meta.directive.owl punctuation.separator.key-value.owl
      set: owl-directive-value
    - include: tag-else-pop

  owl-directive-value:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: owl-directive-double-js-string
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.owl

      - match: \'
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: owl-directive-single-js-string
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.owl

      - include: tag-else-pop

  owl-directive-double-js-string:
    # wrapper just to get the "meta.string.owl" in the scope
    - meta_scope: meta.string.owl string.quoted.double.owl source.js.embedded.owl
    - include: scope:source.js

  owl-directive-single-js-string:
    # wrapper just to get the "meta.string.owl" in the scope
    - meta_scope: meta.string.owl string.quoted.single.owl source.js.embedded.owl
    - include: scope:source.js

  # -----------------------------------------------------------------------
  # `t-attf-`
  # -----------------------------------------------------------------------

  owl-attf-assignment:
    - meta_content_scope: meta.directive.owl
    - match: =
      scope: meta.directive.owl punctuation.separator.key-value.owl
      set: owl-attf-attribute
    - include: tag-else-pop

  owl-attf-attribute:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: owl-attf-string
        embed_scope: meta.string.owl
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.owl
      - match: \'
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: owl-attf-string
        embed_scope: meta.string.owl
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.owl
      - include: tag-else-pop

  owl-attf-string:
    - meta_scope: string.quoted.double.owl-attf
    - match: \{\{
      captures:
        0: punctuation.section.interpolation.begin.owl
      embed: scope:source.js # not using `#expression` for `and` operator
      embed_scope: source.js
      escape: \}\}
      escape_captures:
        0: punctuation.section.interpolation.end.owl
    - meta_scope: string.quoted.double.owl-attf
    - match: '#\{'
      captures:
        0: punctuation.section.interpolation.begin.owl
      embed: scope:source.js # not using `#expression` for `and` operator
      embed_scope: source.js
      escape: \}
      escape_captures:
        0: punctuation.section.interpolation.end.owl

  # -----------------------------------------------------------------------
  # OWL components (camel case tag), and `<t t-call="...">` / `<t
  # t-set-slot="...">` (whose non-`t-*` attributes are call/slot
  # parameters, evaluated as JS just like component attributes)
  # -----------------------------------------------------------------------

  owl-component-tag:
    - match: (<)([A-Z][A-Za-z0-9_]+)
      captures:
        1: punctuation.definition.tag.begin.opening.xml
        2: variable.function.owl entity.name.tag.localname.xml
      push: owl-component-tag-content
    - match: (<)(t)(?=[^>]*\b(?:t-call|t-set-slot)\b)
      captures:
        1: punctuation.definition.tag.begin.opening.xml
        2: entity.name.tag.localname.xml
      push: owl-component-tag-content

  owl-component-tag-content:  # attributes of OWL component (everything is JS)
    - meta_scope: meta.tag.xml
    - match: />
      scope: punctuation.definition.tag.end.self-closing.xml
      pop: 1
    - match: '>'
      scope: punctuation.definition.tag.end.opening.xml
      pop: 1
    - match: \?>
      scope: invalid.illegal.bad-tag-end.xml
      pop: 1
    - include: owl-directive
    - include: owl-component-directive
    - include: tag-end-missing-pop
    - include: tag-attribute

  owl-component-directive:
    - match: (?i:({{owl_attribute_charset}}+.translate)|size)
      scope: entity.other.attribute-name
      push: string-quoted-pop
    - match: (?i:{{owl_attribute_charset}}+)
      scope: entity.other.attribute-name
      push: owl-directive-assignment

  # -----------------------------------------------------------------------
  # Special tags that contain code
  # -----------------------------------------------------------------------

  # <attribute name="..."> : patches an attribute via <xpath position="attributes">
  # - with a body: the body is the new value, embedded as JS when `name` is a
  #   `t-*` directive, attf-parsed when `name` is `t-attf-*`/`t-valuef`
  # - with `add`/`remove`/`separator` instead (no body, self-closing): same
  #   embedding rules apply to `add`/`remove` (spliced into the resulting
  #   value via `separator`, which itself stays plain); plain for any other
  #   `name`, e.g. <attribute name="class" add="mt-1" remove="mt-2"/>
  owl-attribute-tag:
    - match: (<)(attribute)\b
      captures:
        1: punctuation.definition.tag.begin.opening.xml
        2: entity.name.tag.localname.xml
      push: owl-attribute-tag-content

  owl-attribute-tag-content:
    - meta_scope: meta.tag.xml
    - match: />
      scope: punctuation.definition.tag.end.self-closing.xml
      pop: 1
    - match: (name)(=)(\")(t-attf-{{owl_attribute_charset}}+|t-valuef)(\")
      captures:
        1: entity.other.attribute-name
        2: punctuation.separator.key-value.xml
        3: meta.string.xml punctuation.definition.string.begin.xml
        4: string.quoted.double.xml
        5: meta.string.xml punctuation.definition.string.end.xml
      set: owl-attribute-tag-attf-name
    - match: (name)(=)(\")(t-{{owl_attribute_charset}}+)(\")
      captures:
        1: entity.other.attribute-name
        2: punctuation.separator.key-value.xml
        3: meta.string.xml punctuation.definition.string.begin.xml
        4: string.quoted.double.xml
        5: meta.string.xml punctuation.definition.string.end.xml
      set: owl-attribute-tag-code-name
    - include: tag-end-missing-pop
    - include: tag-attribute
    - match: '>'
      scope: punctuation.definition.tag.end.opening.xml
      pop: 1

  owl-attribute-tag-code-name:
    - meta_scope: meta.tag.xml
    - match: (add|remove)
      scope: entity.other.attribute-name
      push: owl-directive-assignment
    - match: (>)
      captures:
        1: punctuation.definition.tag.end.opening.xml
      embed: scope:source.js
      embed_scope: source.js
      escape: (</)(attribute)(>)
      escape_captures:
          1: punctuation.definition.string.end.qweb
          2: entity.name.tag.localname.xml
          3: punctuation.definition.string.end.qweb
      pop: 1
    - include: owl-attribute-tag-fallback

  owl-attribute-tag-attf-name:
    - meta_scope: meta.tag.xml
    - match: (add|remove)
      scope: entity.other.attribute-name
      push: owl-attf-assignment
    - match: (>)
      captures:
        1: punctuation.definition.tag.end.opening.xml
      embed: owl-attf-string
      embed_scope: meta.string.owl
      escape: (</)(attribute)(>)
      escape_captures:
          1: punctuation.definition.string.end.qweb
          2: entity.name.tag.localname.xml
          3: punctuation.definition.string.end.qweb
      pop: 1
    - include: owl-attribute-tag-fallback

  owl-attribute-tag-fallback:
    - match: />
      scope: punctuation.definition.tag.end.self-closing.xml
      pop: 1
    - include: tag-end-missing-pop
    - include: tag-attribute

  # -----------------------------------------------------------------------
  # `expr` (xpath expression, used by <xpath expr="...">)
  # -----------------------------------------------------------------------

  owl-xpath-assignment:
    - meta_content_scope: meta.directive.owl
    - match: =
      scope: meta.directive.owl punctuation.separator.key-value.owl
      set: owl-xpath-value
    - include: tag-else-pop

  owl-xpath-value:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: scope:source.xpath
        embed_scope: source.xpath
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.owl
      - match: \'
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: scope:source.xpath
        embed_scope: source.xpath
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.owl
      - include: tag-else-pop

  # -----------------------------------------------------------------------
  # `position` (view/xpath inheritance operation, a fixed set of values)
  # -----------------------------------------------------------------------

  owl-position-assignment:
    - meta_content_scope: meta.directive.owl
    - match: =
      scope: meta.directive.owl punctuation.separator.key-value.owl
      set: owl-position-value
    - include: tag-else-pop

  owl-position-value:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: owl-position-content
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.owl
      - match: \'
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: owl-position-content
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.owl
      - include: tag-else-pop

  owl-position-content:
    - meta_scope: string.quoted.double.owl
    - match: \b(inside|after|before|replace|attributes|move)\b
      scope: constant.language.position.odoo-owl
    - match: \S+
      scope: invalid.illegal.position.odoo-owl

  # -----------------------------------------------------------------------
  # Attribute that should be added in symbols list
  # -----------------------------------------------------------------------

  owl-symbols-assignment:
    - meta_content_scope: meta.directive.owl
    - match: =
      scope: meta.directive.owl punctuation.separator.key-value.owl
      set: owl-symbols-attribute
    - include: tag-else-pop

  owl-symbols-attribute:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: owl-symbols-string
        embed_scope: meta.string.owl
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.owl
      - match: \'
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: owl-symbols-string
        embed_scope: meta.string.owl
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.owl
      - include: tag-else-pop

  owl-attribute-string:
    - meta_scope: string.quoted.double.owl

  owl-symbols-string:
    - meta_scope: string.quoted.double.owl
    - match: .+
      scope: entity.name.class.owl

  owl-reference-assignment:
    - meta_content_scope: meta.directive.owl
    - match: =
      scope: meta.directive.owl punctuation.separator.key-value.owl
      set: owl-reference-attribute
    - include: tag-else-pop

  owl-reference-attribute:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: owl-reference-string
        embed_scope: meta.string.owl variable.function.owl
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.owl
      - match: \'
        captures:
          0: punctuation.definition.string.begin.owl
        pop: 1
        embed: owl-reference-string
        embed_scope: meta.string.owl variable.function.owl
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.owl
      - include: tag-else-pop

  owl-reference-string:
    - meta_scope: string.quoted.double.owl
