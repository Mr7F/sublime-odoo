%YAML 1.2
---
# Odoo view / template with python as expression
name: XML - Odoo - View
scope: text.xml.odoo-view
version: 2

extends: Packages/XML/XML.sublime-syntax

file_extensions:
  - xml

variables:
  owl_attribute_charset: '[A-Za-z0-9._-]'
  view_python_attribute_name: 'readonly|invisible|context|options|domain|search|required|column_invisible|colors|eval|filter_domain|decoration-[A-Za-z0-9._-]+'

contexts:
  tag-attribute:
    - meta_prepend: true
    - include: view-directive
    - include: qweb-directive

  # -----------------------------------------------------------------------
  # view attributes
  # -----------------------------------------------------------------------

  view-directive:
    - match: ({{view_python_attribute_name}})
      scope: entity.other.attribute-name
      push: view-directive-assignment
    - match: (expr)
      scope: entity.other.attribute-name
      push: view-xpath-assignment
    - match: (position)
      scope: entity.other.attribute-name
      push: view-position-assignment
    - match: (ref|inherit_id)
      scope: entity.other.attribute-name
      push: qweb-reference-assignment

  view-directive-assignment:
    - meta_content_scope: meta.directive.qweb
    - match: =
      scope: meta.directive.qweb punctuation.separator.key-value.qweb
      set: view-directive-value
    - include: tag-else-pop

  view-directive-value:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: scope:source.python
        embed_scope: source.python
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - match: \'
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: scope:source.python
        embed_scope: source.python
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - include: tag-else-pop

  # -----------------------------------------------------------------------
  # `expr` (xpath expression, used by <xpath expr="...">)
  # -----------------------------------------------------------------------

  view-xpath-assignment:
    - meta_content_scope: meta.directive.qweb
    - match: =
      scope: meta.directive.qweb punctuation.separator.key-value.qweb
      set: view-xpath-value
    - include: tag-else-pop

  view-xpath-value:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: scope:source.xpath
        embed_scope: source.xpath
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - match: \'
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: scope:source.xpath
        embed_scope: source.xpath
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - include: tag-else-pop

  # -----------------------------------------------------------------------
  # `position` (view/xpath inheritance operation, a fixed set of values)
  # -----------------------------------------------------------------------

  view-position-assignment:
    - meta_content_scope: meta.directive.qweb
    - match: =
      scope: meta.directive.qweb punctuation.separator.key-value.qweb
      set: view-position-value
    - include: tag-else-pop

  view-position-value:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: view-position-content
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - match: \'
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: view-position-content
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - include: tag-else-pop

  view-position-content:
    - meta_scope: string.quoted.double.qweb
    - match: \b(inside|after|before|replace|attributes|move)\b
      scope: constant.language.position.odoo-view
    - match: \S+
      scope: invalid.illegal.position.odoo-view

  # -----------------------------------------------------------------------
  # tag that contain code
  # -----------------------------------------------------------------------

  tag:
    - meta_prepend: true
    - include: odoo-button
    - include: owl-component-tag
    - include: odoo-view-special-tag
    - include: odoo-view-attribute-tag
    - include: t-tag-with-tcall

  odoo-button:
    - match: (<)(button)\b
      captures:
        1: punctuation.definition.tag.begin.opening.xml
        2: entity.name.tag.localname.xml
      push:
        - meta_scope: meta.tag.opening.xml
        - match: (/?>)
          captures:
            1: punctuation.definition.tag.end.opening.xml
          pop: 1
          # name are reported as "symbols" for "go to references"
        - match: (name)(\s*)(=)(\s*)(["'])([A-Za-z_][A-Za-z0-9_]*)(\5)
          captures:
            1: entity.other.attribute-name
            3: punctuation.separator.key-value.qweb
            5: meta.string.qweb punctuation.definition.string.begin.qweb
            6: meta.string.qweb string.quoted.qweb source.python variable.function.qweb
            7: meta.string.qweb punctuation.definition.string.end.qweb
        - include: tag-attribute

  # Special tags that contain code
  odoo-view-special-tag:
    - match: (<)(field)\s(name)(=)(\")(domain|domain_force|context|code)(\")(>)
      captures:
        1: punctuation.definition.tag.begin.opening.xml
        2: entity.name.tag.localname.xml
        3: entity.other.attribute-name
        4: punctuation.separator.key-value.xml
        5: meta.string.xml punctuation.definition.string.begin.xml
        6: string.quoted.double.xml
        7: meta.string.xml punctuation.definition.string.end.xml
        8: punctuation.definition.tag.end.opening.xml
      embed: scope:source.python
      embed_scope: source.python
      escape: (</)(field)(>)
      escape_captures:
          1: punctuation.definition.string.end.qweb
          2: entity.name.tag.localname.xml
          3: punctuation.definition.string.end.qweb

  # <attribute name="..."> : patches an attribute via <xpath position="attributes">
  # - with a body: the body is the new value, embedded as python when `name`
  #   is a known code-holding attribute (or a `t-*` directive), attf-parsed
  #   when `name` is `t-attf-*`/`t-valuef`
  # - with `add`/`remove`/`separator` instead (no body, self-closing): same
  #   embedding rules apply to `add`/`remove` (spliced into the resulting
  #   value via `separator`, which itself stays plain); plain for any other
  #   `name`, e.g. <attribute name="class" add="mt-1" remove="mt-2"/>
  odoo-view-attribute-tag:
    - match: (<)(attribute)\b
      captures:
        1: punctuation.definition.tag.begin.opening.xml
        2: entity.name.tag.localname.xml
      push: odoo-view-attribute-tag-content

  odoo-view-attribute-tag-content:
    - meta_scope: meta.tag.xml
    - match: />
      scope: punctuation.definition.tag.end.self-closing.xml
      pop: 1
    - match: (name)(=)(\")(t-attf-{{owl_attribute_charset}}+|t-valuef)(\")
      captures:
        1: entity.other.attribute-name
        2: punctuation.separator.key-value.xml
        3: meta.string.xml punctuation.definition.string.begin.xml
        4: string.quoted.double.xml
        5: meta.string.xml punctuation.definition.string.end.xml
      set: odoo-view-attribute-tag-attf-name
    - match: (name)(=)(\")({{view_python_attribute_name}}|t-{{owl_attribute_charset}}+)(\")
      captures:
        1: entity.other.attribute-name
        2: punctuation.separator.key-value.xml
        3: meta.string.xml punctuation.definition.string.begin.xml
        4: string.quoted.double.xml
        5: meta.string.xml punctuation.definition.string.end.xml
      set: odoo-view-attribute-tag-code-name
    - include: tag-end-missing-pop
    - include: tag-attribute
    - match: '>'
      scope: punctuation.definition.tag.end.opening.xml
      pop: 1

  odoo-view-attribute-tag-code-name:
    - meta_scope: meta.tag.xml
    - match: (add|remove)
      scope: entity.other.attribute-name
      push: view-directive-assignment
    - match: (>)
      captures:
        1: punctuation.definition.tag.end.opening.xml
      embed: scope:source.python
      embed_scope: source.python
      escape: (</)(attribute)(>)
      escape_captures:
          1: punctuation.definition.string.end.qweb
          2: entity.name.tag.localname.xml
          3: punctuation.definition.string.end.qweb
      pop: 1
    - include: odoo-view-attribute-tag-fallback

  odoo-view-attribute-tag-attf-name:
    - meta_scope: meta.tag.xml
    - match: (add|remove)
      scope: entity.other.attribute-name
      push: qweb-attf-assignment
    - match: (>)
      captures:
        1: punctuation.definition.tag.end.opening.xml
      embed: qweb-attf-string
      embed_scope: meta.string.qweb
      escape: (</)(attribute)(>)
      escape_captures:
          1: punctuation.definition.string.end.qweb
          2: entity.name.tag.localname.xml
          3: punctuation.definition.string.end.qweb
      pop: 1
    - include: odoo-view-attribute-tag-fallback

  odoo-view-attribute-tag-fallback:
    - match: />
      scope: punctuation.definition.tag.end.self-closing.xml
      pop: 1
    - include: tag-end-missing-pop
    - include: tag-attribute

  # -----------------------------------------------------------------------
  # JS template inside python template (kanban view)
  # -----------------------------------------------------------------------

  owl-component-tag:  # OWL template
    - match: (<)(templates)(\s.*)?(>)
      captures:
        1: punctuation.definition.tag.begin.opening.xml
        2: entity.name.tag.localname.xml
        3: tag-attribute-value
        4: punctuation.definition.tag.end.opening.xml
      embed: scope:text.xml.owl
      embed_scope: text.xml.owl
      escape: (</)(templates)(>)
      escape_captures:
          1: punctuation.definition.string.end.qweb
          2: entity.name.tag.localname.xml
          3: punctuation.definition.string.end.qweb

  # -----------------------------------------------------------------------
  # <t ... t-call="..."> : `t` tag with a `t-call` inside of it
  # -----------------------------------------------------------------------

  # all attributes are python code, except
  # - t-call: name
  # - .f - .translate: string format

  t-tag-with-tcall:
    - match: (<)(t)(?=[^>]*\bt-call\b)
      captures:
        1: punctuation.definition.tag.begin.opening.xml
        2: entity.name.tag.localname.xml
      push:
        - meta_scope: meta.tag.opening.xml
        - match: (/?>)
          captures:
            1: punctuation.definition.tag.end.opening.xml
          pop: 1
        - include: t-tag-with-tcall-attribute

  t-tag-with-tcall-attribute:
    - match: (?i:(t-name))
      scope: entity.other.attribute-name
      push: qweb-symbols-assignment
    - match: (?i:(t-call(-{{owl_attribute_charset}}+)?))
      scope: entity.other.attribute-name
      push: qweb-reference-assignment
      # name.f - name.translate -> string format
    - match: (?i:{{owl_attribute_charset}}+(\.f|\.translate))
      scope: entity.other.attribute-name
      push: qweb-attf-assignment
      # any other -> python
    - match: (?i:{{owl_attribute_charset}}+)
      scope: entity.other.attribute-name
      push: qweb-directive-assignment

  # -----------------------------------------------------------------------
  # attribute parsing
  # -----------------------------------------------------------------------

  qweb-directive:
    - match: (?i:(id|t-name))
      scope: entity.other.attribute-name
      push: qweb-symbols-assignment
    # `t-att` attribute
    - match: (?i:(t-name|t-set-slot|t-slot-scope|t-call(-{{owl_attribute_charset}}+)?|t-inherit({{owl_attribute_charset}}*))|t-ref)
      scope: entity.other.attribute-name
      push: tag-else-pop
    - match: (?i:(t-attf-{{owl_attribute_charset}}+)|(t-valuef))
      scope: entity.other.attribute-name
      push: qweb-attf-assignment
    - match: (?i:t-{{owl_attribute_charset}}+)
      scope: meta.directive.owl entity.other.attribute-name
      push: qweb-directive-assignment

  # -----------------------------------------------------------------------
  # `t-att-`
  # -----------------------------------------------------------------------

  qweb-directive-assignment:
    - meta_content_scope: meta.directive.qweb
    - match: =
      scope: meta.directive.qweb punctuation.separator.key-value.qweb
      set: qweb-directive-value
    - include: tag-else-pop

  qweb-directive-value:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: qweb-directive-double-python-string
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.qweb

      - match: \'
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: qweb-directive-single-python-string
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.qweb

      - include: tag-else-pop

  qweb-directive-double-python-string:
    # wrapper just to get the "meta.string.qweb" in the scope
    - meta_scope: meta.string.qweb string.quoted.double.qweb source.python.embedded.qweb
    - include: scope:source.python

  qweb-directive-single-python-string:
    # wrapper just to get the "meta.string.qweb" in the scope
    - meta_scope: meta.string.qweb string.quoted.single.qweb source.python.embedded.qweb
    - include: scope:source.python

  # -----------------------------------------------------------------------
  # `t-attf-`
  # -----------------------------------------------------------------------

  qweb-attf-assignment:
    - meta_content_scope: meta.directive.qweb
    - match: =
      scope: meta.directive.qweb punctuation.separator.key-value.qweb
      set: qweb-attf-attribute
    - include: tag-else-pop

  qweb-attf-attribute:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: qweb-attf-string
        embed_scope: meta.string.qweb
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - match: \'
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: qweb-attf-string
        embed_scope: meta.string.qweb
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - include: tag-else-pop

  qweb-attf-string:
    - meta_scope: string.quoted.double.qweb-attf
    - match: \{\{
      captures:
        0: punctuation.section.interpolation.begin.qweb
      embed: scope:source.python
      embed_scope: source.python
      escape: \}\}
      escape_captures:
        0: punctuation.section.interpolation.end.qweb
    - meta_scope: string.quoted.double.qweb-attf
    - match: '#\{'
      captures:
        0: punctuation.section.interpolation.begin.qweb
      embed: scope:source.python
      embed_scope: source.python
      escape: \}
      escape_captures:
        0: punctuation.section.interpolation.end.qweb

  # -----------------------------------------------------------------------
  # Attribute that should be added in symbols list
  # -----------------------------------------------------------------------

  qweb-symbols-assignment:
    - meta_content_scope: meta.directive.qweb
    - match: =
      scope: meta.directive.qweb punctuation.separator.key-value.qweb
      set: qweb-symbols-attribute
    - include: tag-else-pop

  qweb-symbols-attribute:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: qweb-symbols-string
        embed_scope: meta.string.qweb
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - match: \'
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: qweb-symbols-string
        embed_scope: meta.string.qweb
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - include: tag-else-pop

  qweb-attribute-string:
    - meta_scope: string.quoted.double.qweb

  qweb-symbols-string:
    - meta_scope: string.quoted.double.qweb
    - match: .+
      scope: entity.name.class.qweb

  qweb-reference-assignment:
    - meta_content_scope: meta.directive.qweb
    - match: =
      scope: meta.directive.qweb punctuation.separator.key-value.qweb
      set: qweb-reference-attribute
    - include: tag-else-pop

  qweb-reference-attribute:
      - match: \"
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: qweb-reference-string
        embed_scope: meta.string.qweb variable.function.qweb
        escape: \"
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - match: \'
        captures:
          0: punctuation.definition.string.begin.qweb
        pop: 1
        embed: qweb-reference-string
        embed_scope: meta.string.qweb variable.function.qweb
        escape: \'
        escape_captures:
          0: punctuation.definition.string.end.qweb
      - include: tag-else-pop

  qweb-reference-string:
    - meta_scope: string.quoted.double.qweb
