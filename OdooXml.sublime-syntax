%YAML 1.2
---
# Will automatically switch to
# - OWL: when `<template/>` found
# - View: when `<odoo/>` found
# >>> https://github.com/sublimehq/Packages/blob/master/XML/XML.sublime-syntax

name: XML - Odoo
scope: text.xml.odoo
version: 2

extends: Packages/XML/XML.sublime-syntax

file_extensions:
  - xml

contexts:
  tag:
    - meta_prepend: true
    - include: owl-templates-tag
    - include: odoo-view-tag

  owl-templates-tag:  # OWL template
    - match: (<)(templates)
      captures:
        1: punctuation.definition.tag.begin.opening.xml
        2: entity.name.tag.localname.xml
      push: owl-templates-tag-attribute

  owl-templates-tag-attribute:  # attributes of the root `<templates>` tag
    - match: (>)
      captures:
        1: punctuation.definition.tag.end.opening.xml
      embed: scope:text.xml.owl
      embed_scope: text.xml.owl
      escape: (</)(templates)(>)
      escape_captures:
          1: punctuation.definition.string.end.qweb
          2: entity.name.tag.localname.xml
          3: punctuation.definition.string.end.qweb
      pop: 1
    - include: tag-end-missing-pop
    - include: tag-attribute

  odoo-view-tag:  # Odoo view
    - match: (<)(odoo)
      captures:
        1: punctuation.definition.tag.begin.opening.xml
        2: entity.name.tag.localname.xml
      push: odoo-view-tag-attribute

  odoo-view-tag-attribute:  # attributes of the root `<odoo>` tag
    - match: (>)
      captures:
        1: punctuation.definition.tag.end.opening.xml
      embed: scope:text.xml.odoo-view
      embed_scope: text.xml.odoo-view
      escape: (</)(odoo)(>)
      escape_captures:
          1: punctuation.definition.string.end.qweb
          2: entity.name.tag.localname.xml
          3: punctuation.definition.string.end.qweb
      pop: 1
    - include: tag-end-missing-pop
    - include: tag-attribute
